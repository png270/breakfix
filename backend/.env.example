# Export explicitly; backend does not load .env files automatically.
# Use a free local server or sponsor endpoint with function tool-calling support.
BMF_LLM_ENDPOINT=http://127.0.0.1:1234/v1
BMF_LLM_MODEL=configure-tool-capable-model
# BMF_LLM_API_KEY= optional; never commit an actual key
# BMF_GITHUB_TOKEN= optional read-only token for API rate limits
# BMF_FIXTURE_APPROVALS=/absolute/path/to/operator-approved-images.json
# Live API analysis remains deliberately disabled independently of telemetry readiness.

# Export explicitly; never commit the project key.
NEATLOGS_API_KEY=
# Installing telemetry does not enable live analysis.

# Optional ingest base URL; export explicitly (default shown).
# NEATLOGS_ENDPOINT=https://ingest.neatlogs.com

# Optional private immutable browser-worker approval manifest.
# BMF_BROWSER_APPROVAL=/absolute/path/to/browser/approval.json
